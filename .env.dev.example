APP_NAME="ES Portfolio"
APP_ENV=development
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=80

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=dsl-mysql
DB_PORT=3306
DB_DATABASE=edfolio
DB_USERNAME=edfolio_user
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
# Preserve existing keys when the display name changes.
CACHE_PREFIX=es_portfolio_cache
REDIS_PREFIX=es_portfolio_database_
SESSION_COOKIE=es_portfolio_session
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=dsl-redis
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=core-toolbox-mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=dev@datasparklab.local
MAIL_FROM_NAME="${APP_NAME}"

# Optional public frontend links; blank hides each CTA.
UPWORK_URL=
ES_DEVELOPERS_URL=https://developers.edilsonsantos.co.za
SUPPORT_URL=
COFFEE_URL=https://buymeacoffee.com/edilsonsantos

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

JWT_BLACKLIST_ENABLED=false
JWT_SECRET=

###################
# Docker Settings #
###################

# Application Configuration
PHP_IMAGE=php:8.2-apache
APP_CONTAINER_NAME=es_portfolio_app
APP_DOCKERFILE=Dockerfile.debug
APP_NETWORK=milkyway
EXTERNAL_NETWORK=milkyway
NETWORK_DRIVER=bridge

# Database Configuration
EXTERNAL_DB_HOST=dsl-mysql
EXTERNAL_DB_NAME=edfolio
EXTERNAL_DB_USER=edfolio_user
EXTERNAL_DB_PASSWORD=

# Node Configuration
NODE_IMAGE=node:16-alpine
NODE_CONTAINER_NAME=es_portfolio_node
NODE_ENV=development
NPM_COMMAND=install

# Build Configuration
SEED_DB=false
WATCH_ASSETS=false
OPTIMIZE_APP=false
RUN_MIGRATIONS=true
FORCE_COMPOSER_INSTALL=false
FORCE_NPM_INSTALL=false
BUILD_ASSETS=true
INSTALL_DEPENDENCIES=false
COMPOSER_FLAGS=--no-interaction