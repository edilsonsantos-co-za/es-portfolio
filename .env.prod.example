APP_NAME="ES Portfolio"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://edilsonsantos.co.za
APP_PORT=80

# Force HTTPS for assets and security
ASSET_URL=https://edilsonsantos.co.za
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=edilsonsantos.co.za
TRUSTED_PROXIES=*

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=dsl-mysql
DB_PORT=3306
DB_DATABASE=edfolio
DB_USERNAME=edfolio_user
DB_PASSWORD=
DB_SSL_MODE=DISABLED

BROADCAST_DRIVER=log
CACHE_DRIVER=file
# Preserve existing keys when the display name changes.
CACHE_PREFIX=edfolio_cache
REDIS_PREFIX=edfolio_database_
SESSION_COOKIE=edfolio_session
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=dsl-redis
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@edilsonsantos.co.za
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

JWT_BLACKLIST_ENABLED=false
JWT_SECRET=

###################
# Docker Settings #
###################

# Application Configuration
PHP_IMAGE=php:8.2-apache
APP_CONTAINER_NAME=edfolio_app
APP_DOCKERFILE=Dockerfile
APP_NETWORK=edfolio_network
EXTERNAL_NETWORK=milkyway
NETWORK_DRIVER=bridge

# Database Configuration
EXTERNAL_DB_HOST=dsl-mysql
EXTERNAL_DB_NAME=edfolio
EXTERNAL_DB_USER=edfolio_user
EXTERNAL_DB_PASSWORD=

# Node Configuration
NODE_IMAGE=node:20-alpine
NODE_CONTAINER_NAME=edfolio_node
NODE_ENV=production
NPM_COMMAND=ci

# Build Configuration
SEED_DB=false
WATCH_ASSETS=false
OPTIMIZE_APP=true
RUN_MIGRATIONS=auto
RUN_SEEDING=auto
FORCE_FRESH_DB=false
CREATE_DB_BACKUP=true
SKIP_ASSET_BUILD=false
FORCE_COMPOSER_INSTALL=false
FORCE_NPM_INSTALL=false
BUILD_ASSETS=true
INSTALL_DEPENDENCIES=false
COMPOSER_FLAGS="--no-dev --optimize-autoloader --no-interaction"
# Initial admin account (seeded only when no admin exists; required in production)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Comma-separated origins allowed to call /api cross-origin (defaults to APP_URL)
CORS_ALLOWED_ORIGINS=
