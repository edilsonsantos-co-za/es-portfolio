.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker files (avoid recursion)
Dockerfile*
docker-compose*.yml

# Testing
tests/
phpunit.xml
.phpunit.result.cache

# Other
storage/
bootstrap/cache/
