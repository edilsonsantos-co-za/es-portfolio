{
    "private": true,
    "engines": {
        "node": ">=20.20.2 <21",
        "npm": ">=10 <11"
    },
    "scripts": {
        "dev": "vite",
        "development": "vite",
        "watch": "vite build --watch",
        "watch-poll": "vite build --watch",
        "hot": "vite",
        "prod": "npm run production",
        "production": "vite build",
        "lint": "eslint resources/js --ext .js,.jsx --no-error-on-unmatched-pattern",
        "build": "npm run production",
        "build:dev": "vite build --mode development",
        "build:prod": "npm run production",
        "audit:npm": "npm audit --legacy-peer-deps",
        "audit:npm:production": "npm audit --omit=dev --legacy-peer-deps",
        "audit:composer": "composer audit --no-interaction",
        "security-check": "npm audit fix",
        "security-check-force": "npm audit fix --force",
        "update-browser-db": "npm_config_legacy_peer_deps=true npx update-browserslist-db@latest"
    },
    "devDependencies": {
        "@babel/preset-react": "^7.29.7",
        "@vitejs/plugin-react": "^6.0.2",
        "axios": "^1.17.0",
        "eslint": "^7.22.0",
        "eslint-plugin-react": "^7.23.1",
        "laravel-vite-plugin": "^3.1.0",
        "lodash": "^4.18.1",
        "postcss": "^8.5.15",
        "prop-types": "^15.7.2",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "vite": "^8.0.16"
    },
    "dependencies": {
        "@ant-design/charts": "^2.6.7",
        "@ant-design/plots": "^2.6.8",
        "@ant-design/pro-layout": "^7.17.16",
        "@ant-design/pro-table": "^3.14.5",
        "@loadable/component": "^5.16.4",
        "antd": "^5.12.8",
        "filepond": "^4.32.12",
        "filepond-plugin-file-encode": "^2.1.10",
        "filepond-plugin-file-validate-size": "^2.2.4",
        "filepond-plugin-file-validate-type": "^1.2.6",
        "filepond-plugin-image-preview": "^4.6.6",
        "less": "^4.6.4",
        "mini-dynamic-antd-theme": "^0.5.3",
        "moment": "^2.30.1",
        "nprogress": "^0.2.0",
        "rc-field-form": "^2.7.1",
        "rc-queue-anim": "^1.8.5",
        "react-color": "^2.19.3",
        "react-countup": "^4.3.3",
        "react-filepond": "^7.1.1",
        "react-icons": "^4.2.0",
        "react-is": "^19.2.7",
        "react-redux": "^9.3.0",
        "react-router": "^5.3.4",
        "react-router-dom": "^5.3.4",
        "reddit-image-fetcher": "^2.0.12",
        "redux": "^4.0.5",
        "redux-thunk": "^2.3.0",
        "styled-components": "^5.2.1",
        "typed.js": "^2.0.12"
    }
}
