APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=80

# Force HTTPS for assets and security
ASSET_URL=
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=dsl-mysql
DB_PORT=3306
DB_DATABASE=edfolio
DB_USERNAME=edfolio_user
DB_PASSWORD=REDACTED

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=dsl-redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=core-toolbox-mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=dev@datasparklab.local
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
MEDIA_DISK=public

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

JWT_BLACKLIST_ENABLED=false
JWT_SECRET=

###################
# Docker Settings #
###################

# Application Configuration
PHP_IMAGE=php:8.2-apache
APP_CONTAINER_NAME=laravel_app
APP_DOCKERFILE=Dockerfile
APP_NETWORK=laravel_network
EXTERNAL_NETWORK=milkyway
NETWORK_DRIVER=bridge

# Database Configuration
EXTERNAL_DB_HOST=dsl-mysql
EXTERNAL_DB_NAME=edfolio
EXTERNAL_DB_USER=edfolio_user
EXTERNAL_DB_PASSWORD=REDACTED

# Node Configuration
NODE_IMAGE=node:18-alpine
NODE_CONTAINER_NAME=laravel_node
NODE_ENV=development
NPM_COMMAND=install

# Build Configuration
SEED_DB=true
WATCH_ASSETS=true
OPTIMIZE_APP=false
RUN_MIGRATIONS=auto
RUN_SEEDING=auto
FORCE_FRESH_DB=false
CREATE_DB_BACKUP=false
SKIP_ASSET_BUILD=false
FORCE_COMPOSER_INSTALL=false
FORCE_NPM_INSTALL=false
BUILD_ASSETS=true
INSTALL_DEPENDENCIES=true
COMPOSER_FLAGS="--optimize-autoloader --no-interaction"
